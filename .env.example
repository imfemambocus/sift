# copy to .env, or let `make .env` do it and generate the key for you.

# base64 of 32 random bytes: openssl rand -base64 32
# the app refuses to start without it, and changing it makes every stored token undecryptable.
SIFT_ENCRYPTION_KEY=

POSTGRES_DB=sift
POSTGRES_USER=sift
POSTGRES_PASSWORD=sift

# comma separated, e.g. uni.lu. empty lets any address register, which is only
# appropriate for an instance nobody else can reach.
SIFT_ALLOWED_EMAIL_DOMAINS=

# required to connect GitLab at all: an approval on your instance is the only way in.
# make an application under User Settings, Applications, with the scope read_api and exactly
# the redirect URI below. copy its Application ID and Secret here. leave Confidential ticked.
SIFT_GITLAB_URL=https://gitlab.com
SIFT_GITLAB_CLIENT_ID=
SIFT_GITLAB_CLIENT_SECRET=
SIFT_GITLAB_REDIRECT_URI=http://localhost:7777/api/sources/gitlab/oauth/callback

# required to connect Gmail at all, and independent of the GitLab values: connect either, both or
# neither. make an OAuth client of type "Web application" in a Google Cloud project, enable the
# Gmail API there, and give the client exactly the redirect URI below.
# see "Connect Gmail" in the README, including the seven-day trap while the app stays in testing.
SIFT_GMAIL_CLIENT_ID=
SIFT_GMAIL_CLIENT_SECRET=
SIFT_GMAIL_REDIRECT_URI=http://localhost:7777/api/sources/gmail/oauth/callback

# how far back the very first read of a mailbox goes. every read after that takes only what is
# newer, so this bounds what connecting Gmail pulls in and nothing else.
SIFT_GMAIL_WINDOW=P14D

# how often Sift re-reads each connected source. ISO-8601 durations. Drop the interval to
# something like PT20S while testing, so you are not waiting five minutes to see a change.
SIFT_SYNC_INTERVAL=PT5M
SIFT_SYNC_INITIAL_DELAY=PT30S
